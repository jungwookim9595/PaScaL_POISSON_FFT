# =============================================================================
# Build outputs.
#
# Every path below is produced by a Makefile and deleted by its clean target,
# so nothing under version control lives in them.  doc/ and doc_build/ are NOT
# here on purpose: GitHub Pages serves the generated documentation from the
# repository, so those must stay tracked.
# =============================================================================

# Object files, Fortran modules, libraries, executables
*.o
*.mod
*.a
*.so
*.exe
*__genmod.f90

# Per-translation-unit logs from the C++ build (obj/%.o.log) and its summary
*.o.log
build.log

# Object trees, whatever the build MODE is named
obj/

# Generated include/lib trees.
#   00_C/PaScaL_TDMA/src/Makefile:  'inc: cp pascal_tdma.hpp ../include'
#                                   'clean: rm -rf ../lib ../include'
#   01_Fortran/src/makefile:        INCLUDEDIR=../include/$(MODE), LIBDIR=../lib/$(MODE)
# The header in 00_C/PaScaL_TDMA/include is a copy of the one in src, not a
# separate source file, so ignoring the directory loses nothing.
00_C/PaScaL_TDMA/include/
00_C/PaScaL_TDMA/lib/
01_Fortran/include/
01_Fortran/lib/
01_Fortran/PaScaL_TDMA/include/
01_Fortran/PaScaL_TDMA/lib/

# cuDecomp built out of 01_Fortran/vendor with CMake
01_Fortran/_build/
01_Fortran/_install/

# Solver binaries.  The PARA_INPUT_*.dat decks next to them stay tracked:
# they are the reference problem definitions, not build output.
00_C/run/*.exe
01_Fortran/run/*.exe

# Solution dumps written by the examples (dir_instantfield / dir_cont_fileout)
run/data/
*/run/data/
